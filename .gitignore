# Root build output
/out/

# Workspace-local scratch data and legacy runtime saves
/temp/
/saves/

# Java project generated output and local runtime state
/Java/out/
/Java/out-check/
/Java/out-*/
/Java/saves/
/Java/config/settings.properties
/Java/exports/
/Java/temp/

# Compiled classes and Python tool caches
*.class
__pycache__/
*.pyc

# JVM profiling recordings and crash reports
*.jfr
hs_err_pid*.log
replay_pid*.log
